---
interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<section class="flex flex-col items-center text-center">
  <h1
    class="bg-gradient-to-r from-base-700 via-accent-500 to-base-400 bg-clip-text text-6xl font-bold tracking-tight text-transparent sm:text-8xl md:text-9xl"
  >
    DrGlasdou
  </h1>
  <p class="mt-6 max-w-md text-lg text-base-600 dark:text-base-400">
    {tagline}
  </p>
</section>
