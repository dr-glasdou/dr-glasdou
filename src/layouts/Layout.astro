---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  altLangHref: string;
  langLabel: string;
}

const { title, description, altLangHref, langLabel } = Astro.props;

const dir = Astro.currentLocale === "ar" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={Astro.currentLocale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <script is:inline>
      // Set theme before paint to avoid flash (reads localStorage, falls back to system)
      const stored = localStorage.getItem("theme");
      const theme =
        stored ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
      document.documentElement.style.colorScheme = theme;
    </script>
  </head>
  <body>
    {/* Grid paper background; lines highlight near the cursor */}
    <canvas
      id="bg-fx"
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10"></canvas>
    <script is:inline>
      const canvas = document.getElementById("bg-fx");
      const ctx = canvas.getContext("2d");
      const CELL_W = 96; // 6rem
      const CELL_H = 64; // 4rem
      // ponytail: highlight radius px — lines fade from accent to base over R
      const R = 320;
      const mouse = { x: innerWidth / 2, y: innerHeight * 0.45 };
      let gridColor = "";
      let hiColor = "";

      function readColors() {
        const s = getComputedStyle(document.documentElement);
        const dark = document.documentElement.classList.contains("dark");
        gridColor = s
          .getPropertyValue(dark ? "--color-base-800" : "--color-base-200")
          .trim();
        hiColor = s
          .getPropertyValue(dark ? "--color-accent-500" : "--color-accent-400")
          .trim();
      }

      function draw() {
        const w = innerWidth;
        const h = innerHeight;
        ctx.clearRect(0, 0, w, h);

        const g = ctx.createRadialGradient(
          mouse.x, mouse.y, 0,
          mouse.x, mouse.y, R,
        );
        g.addColorStop(0, hiColor);
        g.addColorStop(1, gridColor);
        ctx.strokeStyle = g;
        ctx.lineWidth = 1;
        ctx.beginPath();
        for (let x = 0; x <= w; x += CELL_W) {
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
        }
        for (let y = 0; y <= h; y += CELL_H) {
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
        }
        ctx.stroke();
      }

      function resize() {
        const dpr = devicePixelRatio || 1;
        canvas.width = innerWidth * dpr;
        canvas.height = innerHeight * dpr;
        canvas.style.width = innerWidth + "px";
        canvas.style.height = innerHeight + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        draw();
      }

      readColors();
      resize();
      addEventListener("pointermove", (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
        requestAnimationFrame(draw);
      });
      addEventListener("resize", resize);
      new MutationObserver(() => {
        readColors();
        draw();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
    </script>

    <div class="fixed right-4 top-4 z-50 flex items-center gap-2">
      <a
        href={altLangHref}
        class="inline-flex h-10 items-center rounded-lg border border-base-300 bg-base-100 px-4 text-sm font-medium text-base-700 transition hover:border-accent-400 hover:text-accent-500 dark:border-base-700 dark:bg-base-900 dark:text-base-300 dark:hover:border-accent-500 dark:hover:text-accent-400"
      >
        {langLabel}
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-base-300 bg-base-100 text-base-700 transition hover:border-accent-400 hover:text-accent-500 dark:border-base-700 dark:bg-base-900 dark:text-base-300 dark:hover:border-accent-500 dark:hover:text-accent-400"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
      <svg
        class="h-5 w-5 dark:hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v1.5M12 19.5V21M3 12h1.5M19.5 12H21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M5.6 18.4l1.1-1.1M17.3 6.7l1.1-1.1M12 8.25a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5Z"
        ></path>
      </svg>
      <svg
        class="hidden h-5 w-5 dark:block"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75 9.75 9.75 0 0 1 8.25 6c0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25 9.75 9.75 0 0 0 12.75 21a9.753 9.753 0 0 0 8.998-5.998Z"
        ></path>
      </svg>
      </button>
    </div>

    <main
      class="relative flex min-h-screen flex-col items-center justify-center px-6"
    >
      <slot />
    </main>

    <script>
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", async () => {
        const root = document.documentElement;
        // Animate the theme switch with a View Transition
        if (document.startViewTransition) {
          await document.startViewTransition(async () => {
            const next = root.classList.contains("dark") ? "light" : "dark";
            root.classList.toggle("dark", next === "dark");
            root.style.colorScheme = next;
            localStorage.setItem("theme", next);
          }).finished;
        } else {
          root.classList.toggle("dark");
          localStorage.setItem(
            "theme",
            root.classList.contains("dark") ? "dark" : "light",
          );
        }
      });
    </script>
  </body>
</html>
